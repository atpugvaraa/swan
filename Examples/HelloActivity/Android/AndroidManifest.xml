<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="swan.helloactivity">
    <application android:label="HelloActivity">
        <!-- The Java class is generated from the Swift one: <module name, lowercased>.<Swift class>. -->
        <activity android:name="helloactivity.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
